# Investigation 4 - Version A: Dependency-Heavy
# 20 uops. Op mix: 7 ADD, 2 IMUL, 5 LOAD, 2 FMUL, 2 FADD, 1 STORE, 1 BRANCH
# Long serial chains. Load chain dominates: A02->A06..A10->A15.

A00 ADD  R01, R00, R00
A01 ADD  R02, R01, R00
A02 ADD  R03, R02, R00
A03 ADD  R04, R03, R00
A04 ADD  R05, R04, R00
A05 ADD  R06, R05, R00

A06 LOAD R10, [R03 + 0]
A07 LOAD R11, [R10 + 0]
A08 LOAD R12, [R11 + 0]
A09 LOAD R13, [R12 + 0]
A10 LOAD R14, [R13 + 0]

A11 FMUL F10, F02, F03
A12 FADD F11, F10, F04
A13 FMUL F12, F11, F05
A14 FADD F13, F12, F06

A15 STORE [R06 + 0], R14

A16 IMUL R07, R06, R00
A17 ADD  R08, R07, R00
A18 BRANCH R08, 0
A19 IMUL R09, R08, R01