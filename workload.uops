# Exp08 base workload (I00-I47). Registers are matched to the most recent
# earlier writer, so reused names (R20, R21, R22) behave as if renamed.
I00 ADD R20, R1, R2
I01 ADD R21, R3, R4
I02 LOAD R10, [R20 + 0]
I03 LOAD R11, [R21 + 0]
I04 FMUL F10, F2, F3
I05 FADD F11, F4, F5
I06 ADD R22, R20, R6
I07 IMUL R23, R22, R7
I08 ADD R24, R8, R9
I09 LOAD R12, [R24 + 0]
I10 FMUL F12, F10, F6
I11 FADD F13, F11, F7
I12 ADD R25, R22, R26
I13 LOAD R14, [R25 + 0]
I14 IMUL R27, R25, R28
I15 ADD R29, R27, R30
I16 LOAD R15, [R29 + 0]
I17 FMUL F14, F12, F8
I18 FADD F15, F13, F9
I19 ADD R31, R15, R32
I20 LOAD R16, [R31 + 0]
I21 IMUL R33, R31, R34
I22 ADD R35, R33, R36
I23 FADD F16, F14, F15
I24 LOAD R17, [R35 + 0]
I25 FMUL F17, F16, F10
I26 ADD R37, R35, R38
I27 LOAD R18, [R37 + 0]
I28 FADD F18, F17, F11
I29 IMUL R39, R37, R40
I30 ADD R41, R39, R42
I31 STORE [R41 + 0], R18
I32 ADD R43, R20, R44
I33 ADD R45, R24, R46
I34 LOAD R19, [R43 + 0]
I35 LOAD R20, [R45 + 0]
I36 FMUL F19, F18, F12
I37 FADD F20, F19, F16
I38 ADD R47, R43, R48
I39 IMUL R49, R47, R50
I40 LOAD R21, [R49 + 0]
I41 FADD F21, F20, F17
I42 ADD R51, R49, R52
I43 LOAD R22, [R51 + 0]
I44 FMUL F22, F21, F19
I45 ADD R53, R51, R54
I46 STORE [R53 + 0], R22
I47 ADD R55, R55, R56
